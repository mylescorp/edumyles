{
 "$description": "Tier 3. Optional. Each token defaults to a semantic token. Used only where a component needs finer control. Tenants cannot override these.",
 "button": {
  "primary": {
   "bg": {
    "$value": "{color.action.primary}"
   },
   "bg-hover": {
    "$value": "{color.action.primary-hover}"
   },
   "bg-pressed": {
    "$value": "{color.action.primary-pressed}"
   },
   "bg-disabled": {
    "$value": "{color.action.primary-disabled}"
   },
   "fg": {
    "$value": "{color.text.on-primary}"
   },
   "fg-disabled": {
    "$value": "{color.text.disabled}"
   },
   "border": {
    "$value": "{color.action.primary-border}"
   }
  },
  "secondary": {
   "bg": {
    "$value": "{color.surface.default}"
   },
   "fg": {
    "$value": "{color.action.primary-text}"
   },
   "border": {
    "$value": "{color.action.primary-border}"
   },
   "bg-hover": {
    "$value": "{color.action.primary-subtle}"
   }
  },
