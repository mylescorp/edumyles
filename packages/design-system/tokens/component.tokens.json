   "md": {
    "$value": "{density.comfortable.control-height}"
   },
   "lg": {
    "$value": "44px"
   },
   "xl": {
    "$value": "48px"
   }
  },
  "radius": {
   "$value": "{radius.control}"
  },
  "pad-x": {
   "$value": "{density.comfortable.pad-x}"
  }
 },
 "input": {
  "bg": {
   "$value": "{color.surface.default}"
  },
  "border": {
   "$value": "{color.border.strong}"
  },
  "border-focus": {
   "$value": "{color.focus.ring}"
  },
  "border-error": {
   "$value": "{color.status.danger.solid}"
